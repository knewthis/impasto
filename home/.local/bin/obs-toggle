#!/usr/bin/env bash
# Open OBS: start it if it isn't running, otherwise click its tray icon.
if ! flatpak ps --columns=application | grep -qx com.obsproject.Studio; then
    exec systemctl --user start obs.service
fi

items=$(busctl --user get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
    org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems | grep -o '"[^"]*"' | tr -d '"')

for item in $items; do
    service=${item%%/*}
    path=/${item#*/}
    id=$(busctl --user get-property "$service" "$path" org.kde.StatusNotifierItem Id 2>/dev/null)
    case "${id,,}" in
        *obs*) busctl --user call "$service" "$path" org.kde.StatusNotifierItem Activate ii 0 0 ;;
    esac
done
